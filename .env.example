# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Database Connection (Supabase PostgreSQL)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (port 6543): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Django Security Settings
SECRET_KEY=django-insecure-tbf-2026-edition-change-in-production-key-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
